<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <!-- IMAGE RESOLUTION for single listing  -->
  <% const DEFAULT_IMG
  ="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"; let imgSrc =
  DEFAULT_IMG; const raw = listing.image; if (raw) { if (typeof raw === "object"
  && raw.url) { imgSrc = String(raw.url).trim() || DEFAULT_IMG; } else if
  (typeof raw === "string") { const s = raw.trim(); if (s.length) { if
  (s.includes("unsplash.com/photos")) { const lastDash =
  s.split("-").pop().split(/[?#\/]/)[0]; imgSrc =
  `https://images.unsplash.com/photo-${lastDash}?auto=format&fit=crop&w=1200&q=80`;
  } else { imgSrc = s; } } } } %>

  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%= imgSrc %>"
      class="card-img-top show-img"
      alt="listing_image"
      style="object-fit: cover"
    />
    <div class="card-body">
      <p class="card-text">Owned by: <i><%= listing.owner.username %></i></p>

      <p><%= listing.description %></p>
      <p>&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
      <p><%= listing.location %></p>
      <p><%= listing.country %></p>
    </div>
  </div>
  <br />

  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
  <div class="btns">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark col-1 offset-3 edit-btn"
    >
      Edit
    </a>

    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>
  <% } %>

  <div class="col-8 offset-3 mb-3">
    <hr />
    <% if(currUser) { %>
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
        />
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
      <hr>
      <% } %>
    </form>


    <p><b> All Reviews </b></p>
    <div class="row">
      <% for (let review of listing.reviews) { %>
      <div class="card col-5 mb-3 ms-3">
        <div class="card-body">
          <h5 class="card-title">@<%= review.author.username %></h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="card-text"><%= review.rating %> Stars</p>
        </div>
        <form
          method="POST"
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          class="mb-3 mt-3"
        >
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</div>
